{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/posts/voxelite-renderer",
      "destination": "/posts/quantum-renderer/",
      "permanent": true
    },
    {
      "source": "/posts/voxelite-renderer/",
      "destination": "/posts/quantum-renderer/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
